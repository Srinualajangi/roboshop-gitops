{
  "uid": "roboshop-golden",
  "title": "RoboShop · Golden signals",
  "tags": ["roboshop", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus" },
      { "name": "env", "label": "Environment", "type": "custom", "query": "dev,qa,prod",
        "current": { "text": "dev", "value": "dev" } }
    ]
  },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Traffic — requests/s by status code",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{code}}",
        "expr": "sum by (code) (rate(traefik_service_requests_total{service=~\"roboshop-$env-web.*\"}[5m]))" } ] },
    { "id": 2, "type": "timeseries", "title": "Errors — 5xx ratio",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "5xx ratio",
        "expr": "(sum(rate(traefik_service_requests_total{service=~\"roboshop-$env-web.*\", code=~\"5..\"}[5m])) or vector(0)) / sum(rate(traefik_service_requests_total{service=~\"roboshop-$env-web.*\"}[5m]))" } ] },
    { "id": 3, "type": "timeseries", "title": "Latency — p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"roboshop-$env-web.*\"}[5m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"roboshop-$env-web.*\"}[5m])))" },
        { "refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"roboshop-$env-web.*\"}[5m])))" } ] },
    { "id": 4, "type": "stat", "title": "Pods not ready",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(kube_pod_status_ready{namespace=\"roboshop-$env\", condition=\"false\"}) or vector(0)" } ] },
    { "id": 5, "type": "stat", "title": "Restarts (1h)",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"roboshop-$env\"}[1h])) or vector(0)" } ] },
    { "id": 6, "type": "timeseries", "title": "Saturation — CPU used / requested, by pod",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{pod}}",
        "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"roboshop-$env\", container!=\"\"}[5m])) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"roboshop-$env\", resource=\"cpu\"})" } ] },
    { "id": 7, "type": "timeseries", "title": "Saturation — memory working set / limit, by pod",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{pod}}",
        "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"roboshop-$env\", container!=\"\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"roboshop-$env\", resource=\"memory\"})" } ] }
  ]
}
